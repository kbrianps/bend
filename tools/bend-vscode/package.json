{
  "name": "bend",
  "displayName": "Bend",
  "description": "Syntax highlighting and formatting for Bend 2",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "publisher": "bendlang",
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "engines": {
    "vscode": "^1.82.0",
    "node": ">=22"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:bend"
  ],
  "contributes": {
    "languages": [
      {
        "id": "bend",
        "aliases": [
          "Bend",
          "bend"
        ],
        "extensions": [
          ".bend"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bend",
        "scopeName": "source.bend",
        "path": "./syntaxes/bend.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Bend",
      "properties": {
        "bend.formatter.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `bend2-fmt-lsp`, or to its `server.js`. Empty: the sibling `tools/bend-fmt-lsp` checkout is used, then `bend2-fmt-lsp` on the PATH. With none of them, the extension highlights and does not format."
        },
        "bend.check.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check a `.bend` file with the `bend` binary when it is saved, and underline the error it reports."
        },
        "bend.check.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `bend` binary. Empty: `bend` on the PATH, then `~/.bend/bin/bend`."
        }
      }
    },
    "commands": [
      {
        "command": "bend.check",
        "title": "Check File",
        "category": "Bend",
        "enablement": "editorLangId == bend"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "vscode:prepublish": "npm run build",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.82.0",
    "typescript": "^5.9.0"
  }
}
